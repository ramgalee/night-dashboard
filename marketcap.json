import json
from datetime import datetime
from pykrx import stock

day = stock.get_nearest_business_day_in_a_week(datetime.today().strftime("%Y%m%d"))

caps, info = {}, {}
for mkt in ("KOSPI", "KOSDAQ"):
    cap = stock.get_market_cap(day, market=mkt).reset_index()
    code_col = cap.columns[0]
    for _, row in cap.iterrows():
        code = str(row[code_col]).zfill(6)
        caps[code] = int(row["시가총액"])
        info[code] = [stock.get_market_ticker_name(code), mkt]

out = {
    "date": day,
    "count": len(caps),
    "generatedAt": datetime.now().isoformat(),
    "caps": caps,
    "info": info,          # 종목코드 → [종목명, 시장]
}

with open("marketcap.json", "w", encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False)

print(f"기준일 {day} · {len(caps)}종목 → marketcap.json 저장 완료")
